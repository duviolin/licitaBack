{
  "name": "licitacoes-mvp",
  "version": "1.0.0",
  "description": "MVP Recomendação e Gestão de Licitações Públicas",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev-setup.js && cross-env NODE_ENV=development tsx watch src/server.ts",
    "dev:front": "npm run dev --prefix frontend",
    "build": "prisma generate && tsc",
    "build:front": "npm run build --prefix frontend",
    "build:all": "npm run build && npm run build:front",
    "start": "npm run db:generate && npm run db:migrate && node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "license": "ISC",
  "dependencies": {
    "@nlpjs/lang-pt": "latest",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "express": "^5.2.1",
    "natural": "latest",
    "pdf-parse": "^2.4.5",
    "pg": "^8.17.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.9",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.3",
    "prisma": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
