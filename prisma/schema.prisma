generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MatchStatus {
  NOVO
  FAVORITO
  DESCARTADO
}

enum ParticipacaoStatus {
  ANALISANDO
  PENDENTE_DOC
  APTA
  ENVIADA
  EM_DISPUTA
  GANHA
  PERDIDA
}

enum DocumentoTipo {
  CND_FEDERAL
  CND_ESTADUAL
  CND_MUNICIPAL
  CND_TRABALHISTA
  FGTS
  BALANCO_PATRIMONIAL
  ATESTADO_TECNICO
  CONTRATO_SOCIAL
  ALVARA
  CERTIDAO_FALENCIA
  SICAF
  CNPJ_CARTAO
  PROCURACAO
  DECLARACAO_ME_EPP
  DECLARACAO_INEXISTENCIA_FATO
  DECLARACAO_MENOR
  REGISTRO_CONSELHO
  OUTRO
}

enum DocumentoStatus {
  VALIDO
  VENCIDO
  AUSENTE
}

enum ConformidadeStatus {
  OK
  AUSENTE
  VENCIDO
  INCOMPATIVEL
}

model Empresa {
  id                     String   @id @default(uuid())
  cnpj                   String   @unique
  razaoSocial            String
  nomeFantasia           String   @default("")
  cnaePrincipal          String
  cnaePrincipalDescricao String
  cnaesSecundarios       Json     @default("[]")
  uf                     String   @default("")
  municipio              String   @default("")
  situacaoCadastral      String   @default("")

  stemsCnae              String[]

  palavrasChave          String[] @default([])
  stemsChave             String[] @default([])
  ufsInteresse           String[] @default([])
  modalidadesInteresse   String[] @default([])
  valorMinimo            Decimal? @default(0)
  valorMaximo            Decimal?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  matches       LicitacaoMatch[]
  participacoes Participacao[]
  documentos    EmpresaDocumento[]
}

model Licitacao {
  id               String   @id @default(uuid())
  pncpId           String   @unique
  objeto           String
  orgao            String
  modalidade       String
  valorEstimado    Decimal?
  uf               String
  municipioIbge    String   @default("")
  esfera           String   @default("")
  dataPublicacao   DateTime
  dataAbertura     DateTime?
  dataEncerramento DateTime?
  situacao         String   @default("Divulgada")
  portal           String   @default("PNCP")
  linkPortal       String   @default("")
  linkEdital       String   @default("")

  stemsObjeto      String[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  matches       LicitacaoMatch[]
  participacoes Participacao[]

  @@index([uf])
  @@index([modalidade])
  @@index([dataPublicacao])
  @@index([esfera])
  @@index([situacao])
  @@index([dataEncerramento])
}

model LicitacaoMatch {
  id              String      @id @default(uuid())
  empresaId       String
  licitacaoId     String

  score           Decimal
  scoreTextual    Decimal
  scoreGeografico Decimal
  scoreValor      Decimal
  palavrasMatch   String[]
  status          MatchStatus @default(NOVO)

  createdAt       DateTime @default(now())

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  licitacao Licitacao @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)

  @@unique([empresaId, licitacaoId])
  @@index([empresaId])
  @@index([licitacaoId])
  @@index([score])
  @@index([status])
}

model Participacao {
  id               String             @id @default(uuid())
  empresaId        String
  licitacaoId      String
  dataParticipacao DateTime           @default(now())
  valorProposta    Decimal?
  status           ParticipacaoStatus @default(ANALISANDO)
  observacoes      String             @default("")

  editalUrl                String  @default("")
  editalTexto              String? @db.Text
  portalLink               String  @default("")
  documentosOk             Boolean @default(false)
  checklist                Json?
  percentualConformidade   Int     @default(0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  licitacao Licitacao @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)

  documentosExigidos DocumentoExigido[]
  conformidades      ConformidadeDocumento[]
  prazos             PrazosEdital?

  @@unique([empresaId, licitacaoId])
  @@index([empresaId])
  @@index([licitacaoId])
  @@index([status])
}

model DocumentoExigido {
  id                  String       @id @default(uuid())
  participacaoId      String
  tipo                DocumentoTipo
  nome                String
  secaoEdital         String       @default("")
  obrigatorio         Boolean      @default(true)
  validadeDias        Int?
  autenticacaoExigida Boolean      @default(false)
  referenciaEdital    String       @default("") @db.Text
  createdAt           DateTime     @default(now())

  participacao  Participacao @relation(fields: [participacaoId], references: [id], onDelete: Cascade)
  conformidades ConformidadeDocumento[]

  @@index([participacaoId])
  @@index([tipo])
}

model EmpresaDocumento {
  id         String         @id @default(uuid())
  empresaId  String
  tipo       DocumentoTipo
  nome       String
  arquivoUrl String         @default("")
  validade   DateTime?
  emissor    String         @default("")
  status     DocumentoStatus @default(VALIDO)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  empresa       Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  conformidades ConformidadeDocumento[]

  @@index([empresaId])
  @@index([tipo])
  @@index([status])
}

model ConformidadeDocumento {
  id                 String             @id @default(uuid())
  participacaoId     String
  empresaId          String
  documentoExigidoId String
  empresaDocumentoId String?
  status             ConformidadeStatus
  observacao         String             @default("")
  createdAt          DateTime           @default(now())

  participacao     Participacao     @relation(fields: [participacaoId], references: [id], onDelete: Cascade)
  documentoExigido DocumentoExigido @relation(fields: [documentoExigidoId], references: [id], onDelete: Cascade)
  empresaDocumento EmpresaDocumento? @relation(fields: [empresaDocumentoId], references: [id], onDelete: SetNull)

  @@index([participacaoId])
  @@index([empresaId])
}

model PrazosEdital {
  id                  String    @id @default(uuid())
  participacaoId      String    @unique
  dataAbertura        DateTime?
  dataSessao          DateTime?
  prazoImpugnacao     DateTime?
  prazoEsclarecimento DateTime?
  prazoRecurso        DateTime?
  createdAt           DateTime  @default(now())

  participacao Participacao @relation(fields: [participacaoId], references: [id], onDelete: Cascade)
}
